//go:build linux

package shm

import (
	"context"
	"testing"
	"time"
)

func TestDebugHang(t *testing.T) {
	t.Log("Creating ring...")
	ring, err := NewShmRing(1024, "debug-hang")
	if err != nil {
		t.Fatal(err)
	}
	defer ring.Close()

	t.Log("Starting reader in background...")
	done := make(chan struct{})
	go func() {
		defer close(done)
		t.Log("Reader: Starting ReadSlices...")
		_, _, _, err := ring.ReadSlices(16, context.Background())
		t.Logf("Reader: ReadSlices returned: %v", err)
	}()

	t.Log("Sleeping 100ms...")
	time.Sleep(100 * time.Millisecond)

	t.Log("Closing ring...")
	err = ring.Close()
	if err != nil {
		t.Errorf("Close failed: %v", err)
	}

	t.Log("Waiting for reader to exit...")
	select {
	case <-done:
		t.Log("Reader exited successfully")
	case <-time.After(2 * time.Second):
		t.Fatal("Reader did not exit after ring close")
	}
}
